<%- include('../_top', {title: title}) %>
  <%
    var backHref = expense.report_id ? '/reports/' + expense.report_id : '/expenses';
    var backLabel = expense.report_id ? '← Back to report' : '← Back to expenses';
    // Mileage route state — stops round-trip as JSON; always render at least a
    // From/To pair so the form posts sensibly with JS disabled.
    var mileageStops = [];
    try { mileageStops = JSON.parse(expense.mileage_stops || '[]') || []; } catch (err) { mileageStops = []; }
    while (mileageStops.length < 2) mileageStops.push({ name: '', placeId: '' });
    var mileageUnit = expense.mileage_unit || mileage.unit;
    var mileageRate = (expense.mileage_rate !== null && expense.mileage_rate !== undefined && expense.mileage_rate !== '')
      ? expense.mileage_rate : mileage.rate;
    var stopLabel = function (i, n) { return i === 0 ? 'From' : (i === n - 1 ? 'To' : 'Via ' + i); };
    var stopPlaceholder = function (i, n) { return i === 0 ? 'Start address' : (i === n - 1 ? 'End address' : 'Stop address'); };
  %>
  <div class="page-head">
    <h1><%= title %></h1>
    <div class="page-actions">
      <a class="btn btn-ghost" href="<%= backHref %>"><%= backLabel %></a>
    </div>
  </div>

  <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
    <div class="form-errors">
      <% errors.forEach(er => { %><div>• <%= er %></div><% }); %>
    </div>
  <% } %>

  <% if (ocrError) { %>
    <div class="flash flash-error">OCR failed: <%= ocrError %>. You can still fill the form manually — your receipt is attached.</div>
  <% } %>

  <div class="grid grid-2">
    <div class="card" id="receipt-card"<% if (!isNew) { %> data-expense-id="<%= expense.id %>"<% } %>>
      <h2 class="mt-0">
        Receipt
        <span class="badge badge-ocr" id="receipt-pdf-badge"<% if (!receiptIsPdf) { %> hidden<% } %>>PDF</span>
      </h2>
      <% if (ocrConfidence) { %>
        <p class="hint-text">Scan confidence: <span class="badge badge-ocr"><%= ocrConfidence %></span> — please review the fields.</p>
      <% } %>

      <%#no receipt yet: offer to attach one (no OCR) %>
      <div class="receipt-placeholder" id="receipt-placeholder"<% if (receiptPreview) { %> hidden<% } %>>
        <p class="hint-text" style="margin:0 0 10px;">No receipt attached.</p>
        <button type="button" class="btn btn-primary btn-sm" id="receipt-attach-btn">📎 Attach receipt</button>
      </div>

      <%#receipt present: preview + actions %>
      <div id="receipt-view"<% if (!receiptPreview) { %> hidden<% } %>>
        <a id="receipt-download" href="<%= receiptDownload || receiptPreview %>" target="_blank">
          <img id="receipt-img" class="receipt-preview" src="<%= receiptPreview %>" alt="receipt" style="width:100%;" />
        </a>
        <p class="hint-text" id="receipt-pdf-hint" style="margin-top:10px;"<% if (!receiptIsPdf) { %> hidden<% } %>>
          PDF receipt — <a id="receipt-pdf-link" href="<%= receiptDownload %>" target="_blank">open original ↗</a>
        </p>
        <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
          <% if (!isNew) { %>
            <button type="button" class="btn btn-ghost btn-sm" id="crop-btn"
                    data-expense-id="<%= expense.id %>" data-src="<%= receiptPreview %>"<% if (receiptIsPdf) { %> hidden<% } %>>✂ Crop receipt</button>
          <% } %>
          <button type="button" class="btn btn-ghost btn-sm" id="receipt-change-btn">↻ Change receipt</button>
          <button type="button" class="btn btn-ghost btn-sm" id="receipt-remove-btn">🗑 Remove receipt</button>
        </div>
      </div>

      <%#shared upload input + error, used by Attach and Change %>
      <input type="file" id="receipt-upload" accept="image/*,application/pdf" hidden />
      <p class="hint-text" id="receipt-error" hidden style="color:var(--red);margin-top:8px;"></p>
    </div>

    <div class="card">
      <form method="post" action="<%= isNew ? '/expenses' : '/expenses/' + expense.id %>">
        <input type="hidden" id="receipt-path-input" name="receipt_path" value="<%= receiptPath || '' %>" />

        <div class="field">
          <label for="merchant">Merchant *</label>
          <input id="merchant" name="merchant" type="text" value="<%= expense.merchant %>" required autofocus />
        </div>

        <div class="row-3">
          <div class="field">
            <label for="amount">Amount *</label>
            <input id="amount" name="amount" type="number" step="0.01" min="0" value="<%= expense.amount %>" required />
          </div>
          <div class="field">
            <label for="currency">Currency</label>
            <select id="currency" name="currency">
              <% ['USD','EUR','GBP','CAD','AUD','JPY','INR'].forEach(cur => { %>
                <option <%= expense.currency === cur ? 'selected' : '' %>><%= cur %></option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label for="date">Date *</label>
            <input id="date" name="date" type="date" value="<%= expense.date %>" required />
          </div>
        </div>

        <%#Mileage route builder — revealed by JS when the category is Mileage %>
        <fieldset class="mileage-box" id="mileage-box"<%- isMileage ? '' : ' hidden' %>
                  data-rate="<%= mileageRate %>" data-unit="<%= mileageUnit %>"
                  data-auto="<%= mileage.autoDistance ? '1' : '0' %>">
          <legend>Route</legend>
          <p class="hint-text" style="margin:0 0 10px;">Where did you drive? The first stop is the start, the last is the end.</p>
          <div id="stop-list">
            <% mileageStops.forEach(function (s, i) { %>
              <div class="stop-row">
                <span class="stop-tag"><%= stopLabel(i, mileageStops.length) %></span>
                <input class="stop-input" name="stop[]" type="text" autocomplete="off"
                       placeholder="<%= stopPlaceholder(i, mileageStops.length) %>"
                       value="<%= s.name || '' %>" />
                <input type="hidden" class="stop-place-id" name="stop_place_id[]" value="<%= s.placeId || '' %>" />
                <button type="button" class="btn btn-ghost btn-sm stop-remove" title="Remove stop"<%- mileageStops.length > 2 ? '' : ' hidden' %>>✕</button>
                <div class="ac-list" hidden></div>
              </div>
            <% }); %>
          </div>
          <button type="button" class="btn btn-ghost btn-sm" id="stop-add">+ Add stop</button>
          <div class="row-3" style="margin-top:10px;">
            <div class="field">
              <label for="mileage_distance">Distance (<%= mileageUnit %>)</label>
              <input id="mileage_distance" name="mileage_distance" type="number" step="0.1" min="0"
                     value="<%= expense.mileage_distance || '' %>" />
            </div>
            <div class="field">
              <label for="mileage_rate">Rate per <%= mileageUnit %></label>
              <input id="mileage_rate" name="mileage_rate" type="number" step="0.001" min="0"
                     value="<%= mileageRate %>" />
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <button type="button" class="btn btn-primary btn-sm" id="mileage-calc"<%- mileage.autoDistance ? '' : ' hidden' %>>⚡ Calculate distance</button>
            </div>
          </div>
          <input type="hidden" name="mileage_unit" value="<%= mileageUnit %>" />
          <p class="hint-text" id="mileage-stale" hidden style="margin:6px 0 0;">Route changed — calculate the distance again.</p>
          <p class="hint-text" id="mileage-error" hidden style="color:var(--red);margin:6px 0 0;"></p>
          <% if (!mileage.autoDistance) { %>
            <p class="hint-text" style="margin:6px 0 0;">Tip: set <code>GOOGLE_MAPS_API_KEY</code> to get address autocomplete, automatic driving distance, and a route map receipt.</p>
          <% } %>
        </fieldset>

        <div class="row-3">
          <div class="field">
            <label for="category">Category</label>
            <select id="category" name="category">
              <option value="">— select —</option>
              <% categories.forEach(c => { %>
                <option <%= expense.category === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label for="payment_method">Payment method</label>
            <input id="payment_method" name="payment_method" type="text" value="<%= expense.payment_method %>" placeholder="VISA, Cash…" />
          </div>
          <div class="field">
            <label for="chargeable_to">Chargeable to</label>
            <input id="chargeable_to" name="chargeable_to" type="text" value="<%= expense.chargeable_to %>" placeholder="Who/what this is billed to" />
          </div>
        </div>

        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="2" placeholder="What was this for?"><%= expense.description %></textarea>
        </div>

        <div class="field">
          <label for="report_id">Attach to report</label>
          <select id="report_id" name="report_id">
            <option value="">— none (leave unfiled) —</option>
            <% reports.forEach(r => { %>
              <option value="<%= r.id %>" <%= String(expense.report_id) === String(r.id) ? 'selected' : '' %>>
                <%= r.name %> (<%= money(r.total) %>)
              </option>
            <% }); %>
          </select>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary" type="submit"><%= isNew ? 'Add expense' : 'Save changes' %></button>
          <a class="btn btn-ghost" href="<%= backHref %>">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <% if (!isNew) { %>
    <div class="card">
      <h2 class="mt-0">Danger zone</h2>
      <form method="post" action="/expenses/<%= expense.id %>/delete"
            onsubmit="return confirm('Delete this expense? This cannot be undone.');">
        <button class="btn btn-danger" type="submit">Delete expense</button>
      </form>
    </div>
  <% } %>
<% if (!isNew) { %>
  <link rel="stylesheet" href="/lib/cropperjs/cropper.min.css?v=<%= assetVersion %>" />
  <script src="/lib/cropperjs/cropper.min.js?v=<%= assetVersion %>"></script>
  <div class="crop-overlay" hidden>
    <div class="crop-modal">
      <h3 style="margin-top:0;">Crop receipt</h3>
      <div class="crop-stage">
        <img id="crop-image" alt="crop source" />
      </div>
      <p class="hint-text" id="crop-error" hidden style="color:var(--red);margin-top:8px;"></p>
      <div class="form-actions" style="margin-top:12px;">
        <button type="button" class="btn btn-primary" id="crop-apply">Apply crop</button>
        <button type="button" class="btn btn-ghost" id="crop-cancel">Cancel</button>
      </div>
    </div>
  </div>
<% } %>
<%- include('../_bottom') %>
